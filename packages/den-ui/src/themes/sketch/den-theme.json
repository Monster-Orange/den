{
  "$schema": "https://raw.githubusercontent.com/Monster-Orange/den/main/schemas/den.theme.v1.json",
  "schema": "den.theme/v1",
  "id": "sketch",
  "name": "Sketch",
  "version": "1.0.0",
  "description": "A rough look for work in progress: greys only, dashed edges, outline buttons, one plain face. Previews draw in it until they are reviewed.",
  "author": "Monster Orange",
  "license": "MIT",
  "default_mode": "light",
  "type": {
    "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "shape": {
    "radius": "4px",
    "radius-button": "4px",
    "density": "comfortable",
    "edge": "dashed",
    "buttons": "outline"
  },
  "modes": {
    "light": {
      "bg": "#f5f5f5",
      "surface": "#ffffff",
      "raised": "#ffffff",
      "sunken": "#ebebeb",
      "text": "#1f1f1f",
      "muted": "#4d4d4d",
      "faint": "#5c5c5c",
      "border": "#c2c2c2",
      "border-strong": "#757575",
      "accent": "#3d3d3d",
      "accent-text": "#2e2e2e",
      "accent-fill": "#3d3d3d",
      "on-accent": "#ffffff",
      "ok": "#2e2e2e",
      "warn": "#3d3d3d",
      "bad": "#1f1f1f",
      "remote": "#4d4d4d",
      "shadow": "none",
      "bar": "none"
    },
    "dark": {
      "bg": "#1c1c1c",
      "surface": "#242424",
      "raised": "#2e2e2e",
      "sunken": "#161616",
      "text": "#ededed",
      "muted": "#bdbdbd",
      "faint": "#a3a3a3",
      "border": "#474747",
      "border-strong": "#858585",
      "accent": "#cccccc",
      "accent-text": "#e0e0e0",
      "accent-fill": "#d6d6d6",
      "on-accent": "#1c1c1c",
      "ok": "#d6d6d6",
      "warn": "#c2c2c2",
      "bad": "#f0f0f0",
      "remote": "#b8b8b8",
      "shadow": "none",
      "bar": "none"
    }
  }
}
