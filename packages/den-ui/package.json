{
  "name": "@monster-orange/den-ui",
  "version": "0.7.6",
  "description": "Den's UI kit: tokens, fonts and shared components, framework-free",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monster-Orange/den.git",
    "directory": "packages/den-ui"
  },
  "type": "module",
  "types": "./src/kit.d.ts",
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./base.css": "./src/base.css",
    "./time": "./src/time.js",
    "./update-pill": "./src/update-pill.js",
    "./update-pill.css": "./src/update-pill.css",
    "./busy": "./src/busy.js",
    "./busy-words": "./src/busy-words.js",
    "./save-shell": "./src/save-shell.js",
    "./dialog": "./src/dialog.js",
    "./savestate": "./src/savestate.js",
    "./strings": "./src/strings.js",
    "./icons": "./src/icons.js",
    "./shell-html": "./src/shell-html.js",
    "./shell-client": "./src/shell-client.js",
    "./version": "./src/version.js",
    "./whatsnew": "./src/whatsnew.js",
    "./report": "./src/report.js",
    "./report-shot": "./src/report-shot.js",
    "./kit": "./src/kit.js",
    "./shell.css": "./src/shell.css",
    "./whatsnew.css": "./src/whatsnew.css",
    "./report.css": "./src/report.css",
    "./busy.css": "./src/busy.css",
    "./dialog.css": "./src/dialog.css",
    "./markdown-editor": "./src/markdown-editor.js",
    "./markdown-editor.css": "./src/markdown-editor.css",
    "./savestate.css": "./src/savestate.css",
    "./inventory": {
      "types": "./inventory/nav-inventory.d.ts",
      "default": "./inventory/nav-inventory.js"
    },
    "./inventory/reference/*": "./inventory/reference/*"
  },
  "imports": {
    "#den-ui-fonts-dir": {
      "import": "./inventory/fonts-dir.mjs",
      "require": "./inventory/fonts-dir.cjs",
      "default": "./inventory/fonts-dir.mjs"
    }
  },
  "files": [
    "src/",
    "inventory/",
    "bin/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "den-ui-parity": "bin/den-ui-parity.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/markdown": "1.7.2"
  }
}
