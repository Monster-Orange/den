# Per-engineer local config (email + op:// reference — no passwords)
config/local/

# Journeys staged sandbox cwds (generated per run)
.journeys-run/

# Test results — generated output, never committed. Blanket rule rather than
# per-extension: extension lists are how ~13 MB of PoC screenshots ended up in
# history (reports/*.png was only ignored after the fact, and anything not on
# the list still slipped through).
results/*
!results/.gitkeep
!results/README.md

# Environment variables
.env
.env.local
.env.*.local

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/
playwright/.auth/*.json
!playwright/.auth/.gitkeep
.playwright/

# Node
node_modules/
dist/
build/

# Coverage
coverage/
.nyc_output/

# IDE
# Ignore personal IDE files but track the shared workspace settings
# (.den-services/ etc. must be excluded from the file watcher or VS Code
# locks up — see .vscode/settings.json). Note: ".vscode/*" not ".vscode/",
# because git cannot re-include a child of a fully-ignored directory.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp

# Registered repo mounts (symlinks locally, checkouts in CI)
.den/

# Environment manager: managed service clones (long-lived, branch-tracking)
.den-services/

# Environment manager: feature workspace clones (co-located repos for cross-repo work)
.den-workspaces/

# Git worktrees for feature isolation
.worktrees/

# Smoke test staging area (auto-generated by smoke/setup.ts before each run)
.smoke-run/

# Smoke test repo clones (auto-generated by smoke/setup-env.ts for non-local environments)
.smoke-clones/

# Synthetic test staging area (auto-generated by src/pillars/browser/setup.ts before each run)
.synth-run/

# Performance artifacts (.perf-run/ is legacy staging output from the removed
# perf setup script — kept ignored so old runs don't show up as untracked)
.perf-run/
.perf-report/

# CI shard artifacts (should not be committed)
blob-report/
playwright-reports/
# Generated report output — blanket rule, same rationale as results/ above
# (subsumes the old reports/*.xml, reports/*.png and the per-run
# reports/journeys/ artifacts).
reports/*
!reports/.gitkeep
src/reports/*.xml
src/reports/*.png

# Serena — cache and local overrides are gitignored via .serena/.gitignore

# Graphify

# graphify output (generated; never commit)
graphify-out/

# graphify scratch / resume files
.graphify_*

# graphify internals
graphify-out/.graphify_*
graphify-out/cache/
graphify-out/cost.json

# optional generated expo
graphify-out/graph.svg
graphify-out/graph.graphml
graphify-out/cypher.txt
graphify-out/obsidian/

# graphify artifacts
graphify-out/graph.html
graphify-out/*.svg
graphify-out/*.graphml

# Stack CLI artifacts (caches, OCI layouts, scratch files)
.stack/*
!.stack/bases/

# dev-tooling telemetry local buffer (common-iac dev-metrics)
/.dev-metrics/

# A node_modules symlink (a shared install) is a file, not a dir
node_modules

# Agent worktrees and local tool state
.claude/
