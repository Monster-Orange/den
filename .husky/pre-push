#!/usr/bin/env sh
# No org's names leave this machine (this repo is public, and a pushed commit
# stays reachable by its id even after a rewrite). For every ref pushed, the
# new commits' messages and the pushed commit's files go through the same
# gates CI runs. Names come from DEN_ORG_NAMES, DEN_ORG_NAMES_FILE or the
# per-user file ~/.config/den-dev/org-names.txt; with none the hook passes
# quietly, so a machine without the list can still push. Git worktrees share
# this hook. DEN_PREPUSH_FILES=0 skips the file check (messages only).
#
# Issue 843: first, the fast static checks CI's first job runs (the list in
# scripts/fast-checks.json: version sync, the words gate, the colour and kit
# tokens, i18n parity…), over the checked-out tree, in seconds.
# DEN_PREPUSH_FAST=0 skips them.
# The gates come from the checkout being pushed. DEN_HOOK_ROOT points them
# elsewhere (tests only). Never DEN_ROOT: Den sets that to a distribution.
root="${DEN_HOOK_ROOT:-$(git rev-parse --show-toplevel)}"
zero=0000000000000000000000000000000000000000

if [ "${DEN_PREPUSH_FAST:-1}" != "0" ]; then
  # </dev/null: the refs on this hook's stdin are for the loop below.
  if ! node "$root/scripts/fast-checks.mjs" </dev/null >&2; then
    echo "pre-push: a fast check failed (see above). Fix it, then push again (DEN_PREPUSH_FAST=0 skips them)." >&2
    exit 1
  fi
fi

node --input-type=module -e "
  const { orgPatterns } = await import('$root/scripts/org-names.js');
  process.exit(orgPatterns().length ? 0 : 3);
" 2>/dev/null
case $? in
  0) ;;
  3) exit 0 ;; # no names configured
  *)
    echo "pre-push: the org-name list is set but can't be read; not pushing." >&2
    exit 1
    ;;
esac

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a delete
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # A new branch, or a remote tip this clone hasn't fetched: check from
    # where it left main.
    base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null) ||
      base=$(git merge-base "$local_sha" refs/heads/main 2>/dev/null) || base=""
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    node "$root/scripts/org-name-commits.mjs" "$base..$local_sha" >&2 || status=1
  else
    echo "pre-push: no main to measure $local_ref from; fetch origin/main first." >&2
    status=1
  fi
  if [ "${DEN_PREPUSH_FILES:-1}" != "0" ]; then
    node "$root/scripts/org-name-gate.mjs" --tree "$local_sha" >&2 || status=1
  fi
done

if [ $status -ne 0 ]; then
  echo "pre-push: an org's name is in what you're pushing (see above). Reword or remove it, then push again." >&2
fi
exit $status
