{
  "method": "PUT",
  "path": "/api/installs/self/projects",
  "headers": {
    "Accept": "application/json",
    "Authorization": "Bearer <token>",
    "Content-Type": "application/json",
    "X-Den-Capabilities": "compat.readonly,connect.pkce,connect.rotate,deliveries.ack,deliveries.stream,inbox,mcp.proxy,mcp.tools.watch,notifications,projects.plan,projects.sync",
    "X-Den-Protocol": "1",
    "X-Den-Version": "0.4.68-dev.3"
  },
  "body": {
    "projects": [
      {
        "workspace": "<project>",
        "name": "<project>",
        "repos": [
          "<team>/<project>"
        ],
        "hub_project": "<uuid>",
        "agents": [
          {
            "agent": "<uuid>",
            "name": "<project>",
            "handle": "<project>/<uuid>"
          }
        ]
      }
    ],
    "sent_at": "<iso8601>"
  }
}
