{
  "method": "POST",
  "path": "/connect/token",
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json",
    "X-Den-Capabilities": "compat.readonly,connect.pkce,connect.rotate,deliveries.ack,deliveries.stream,inbox,mcp.proxy,mcp.tools.watch,notifications,projects.plan,projects.sync",
    "X-Den-Protocol": "1",
    "X-Den-Version": "0.4.68-dev.3"
  },
  "body": {
    "grant_type": "authorization_code",
    "code": "<token>",
    "redirect_uri": "https://<host>/hub/callback",
    "code_verifier": "<token>"
  }
}
