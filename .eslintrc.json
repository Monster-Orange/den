{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/ban-ts-comment": "warn",
    "no-empty-pattern": "warn",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["src/pillars/perf/**/*.js"],
      "globals": {
        "__ENV": "readonly",
        "__VU": "readonly",
        "__ITER": "readonly"
      }
    },
    {
      "files": ["src/ui/**/*.ts", "src/shared/**/*.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "TemplateElement[value.raw=/^https?:\\/\\/localhost:$/]",
            "message": "Den's web server listens on 127.0.0.1 (DEN_BIND_HOST), and Node resolves localhost to ::1 first, so a dial can reach another program. Use denWebBase(port) from src/shared/web-dial.ts. A URL shown to a person (not dialled) may disable this line with a reason."
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "playwright-report/",
    "test-results/",
    "*.config.js",
    "*.config.ts"
  ]
}
