{
  "name": "@monster-orange/den",
  "version": "0.4.34-dev.2",
  "description": "Den: a local multi-repo dev orchestrator, HTTPS edge and E2E harness",
  "type": "module",
  "bin": {
    "den": "./bin/den"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/*.test.ts",
    "make/",
    "service/",
    "schemas/",
    "themes/",
    "scripts/auth-configure.ts",
    "scripts/heal-config.ts",
    "scripts/jsonl-playwright-reporter.js",
    "scripts/manifest-read.cjs",
    "scripts/setup-1password.ts",
    "scripts/setup-secrets.ts",
    "scripts/view-results.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "!docs/images/",
    "skills/"
  ],
  "scripts": {
    "cli": "tsx src/ui/cli/index.ts menu",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web-assets.mjs",
    "test:unit": "jest --coverage --forceExit",
    "test:unit:watch": "jest --watch",
    "test:framework": "npm run test:unit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "preflight": "npm run format && npm run lint:fix && npm run test:unit",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.build.json",
    "test": "jest --forceExit",
    "gate:org-names": "node scripts/org-name-gate.mjs",
    "docs:shots": "node scripts/doc-shots.mjs",
    "docs:links": "node scripts/docs-links.js",
    "example:regen": "rm -rf examples/distribution && ./bin/den create acme examples/distribution --port 7777",
    "dist-smoke": "bash scripts/dist-smoke.sh"
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "k6",
    "local-dev",
    "localstack"
  ],
  "author": "Monster Orange",
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "1.0.40",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "^1.61.1",
    "@slack/webhook": "^7.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "auth0": "^4.3.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "dotenv": "^16.4.1",
    "elkjs": "0.12.0",
    "inquirer": "^9.2.14",
    "jsonwebtoken": "^9.0.2",
    "openapi-typescript": "^7.13.0",
    "ora": "^8.0.1",
    "semver": "7.8.6",
    "tsx": "^4.23.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.20.1",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "axe-core": "4.10.3",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "picomatch": "^2.3.2",
    "brace-expansion": "^2.0.3"
  },
  "engines": {
    "node": ">=22.13",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monster-Orange/den.git"
  },
  "homepage": "https://github.com/Monster-Orange/den",
  "bugs": {
    "url": "https://github.com/Monster-Orange/den/issues"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.1.0"
  }
}
