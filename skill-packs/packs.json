  "pstack": {
    "source": "https://github.com/cursor/plugins",
    "path": "pstack",
    "commit": "41e400932eca14f289e7db717a70455256b6d388",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Lauren Tan",
    "exclude": [
      {
        "path": ".cursor-plugin",
        "why": "Cursor's plugin manifest; Den writes a Claude Code one in .claude-plugin/."
      },
      {
        "path": ".gitignore",
        "why": "npm leaves it out of a published package, so the installed copy would fail its hash check."
      },
      {
        "path": "assets",
        "why": "a logo no agent reads."
      },
      {
        "path": "automations",
        "why": "it sets up Cursor cloud automations."
      },
      {
        "path": "docs/guide/01-setup.md",
        "why": "a line matches Den's check for private names (a false match in upstream's text), and Den's repo is public."
      },
      {
        "path": "docs/guide/images",
        "why": "pictures no agent reads."
      },
      {
        "path": "skills/automate-me",
        "why": "it sets up Cursor cloud automations."
      },
      {
        "path": "skills/make-bot-ui",
        "why": "a line matches Den's check for private names (a false match in upstream's text), and Den's repo is public."
      },
      {
        "path": "skills/poteto-mode/playbooks/autopilot-full.md",
        "why": "it has subagents merge pull requests and push after rebases; Den hands a green pull request to whoever merges."
      },
      {
        "path": "skills/poteto-mode/playbooks/babysit.md",
        "why": "it polls GitHub with watch-pr; Den watches checks with github_watch."
      },
      {
        "path": "skills/poteto-mode/playbooks/shipping.md",
        "why": "it merges with gh pr merge and pushes with --force-with-lease; Den never does either."
      },
      {
        "path": "skills/poteto-mode/scripts/watch-pr",
        "why": "it polls GitHub every 60 seconds; Den watches checks with github_watch."
      },
      {
        "path": "skills/setup-pstack",
        "why": "it writes ~/.claude/rules/, outside the agent's folders."
      },
      {
        "path": "skills/statechart/references/render.md",
        "why": "it installs an npm renderer."
      },
      {
        "path": "skills/statechart/scripts/test",
        "why": "377 test files with a dev dependency."
      }
    ],
    "default_off": [
      {
        "skill": "statechart",
        "why": "its TLC run is CPU-heavy and runs outside Den's gate."
      }
    ],
