    "commit": "41e400932eca14f289e7db717a70455256b6d388",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Lauren Tan",
    "exclude": [
      {
        "path": ".cursor-plugin",
        "why": "Cursor's plugin manifest; Den writes a Claude Code one in .claude-plugin/."
      },
      {
        "path": ".gitignore",
        "why": "npm leaves it out of a published package, so the installed copy would fail its hash check."
      },
      {
        "path": "README.md",
        "why": "upstream's README is built around poteto-mode, which is left out; this file says what Den ships."
      },
      {
        "path": "agents/poteto-agent.md",
        "why": "the subagent poteto-mode starts; poteto-mode is left out."
      },
      {
        "path": "assets",
        "why": "a logo no agent reads."
      },
      {
        "path": "automations",
        "why": "it sets up Cursor cloud automations."
      },
      {
        "path": "docs/guide",
        "why": "upstream's guide is built around poteto-mode, which is left out; no skill reads it."
      },
      {
        "path": "plugin.json",
        "why": "upstream's Cursor manifest; Den writes a Claude Code one in .claude-plugin/."
      },
      {
        "path": "skills/automate-me",
        "why": "it sets up Cursor cloud automations."
      },
      {
        "path": "skills/make-bot-ui",
        "why": "a line matches Den's check for private names (a false match in upstream's text), and Den's repo is public."
      },
      {
        "path": "skills/poteto-help",
        "why": "its guide to pstack is a guide to poteto-mode, which is left out."
      },
      {
        "path": "skills/poteto-mode",
        "why": "it tells agents and their subagents never to ask a person, to add no review or sign-off above their kickoff, and that external actions proceed without asking: the opposite of Den's held writes and reviews. Its playbooks and scripts go with it."
      },
      {
        "path": "skills/setup-pstack",
        "why": "it writes ~/.claude/rules/, outside the agent's folders."
      },
      {
        "path": "skills/statechart/references/render.md",
        "why": "it installs an npm renderer."
      },
      {
        "path": "skills/statechart/scripts/test",
        "why": "377 test files with a dev dependency."
      }
    ],
    "default_off": [
      {
        "skill": "statechart",
        "why": "its TLC run is CPU-heavy and runs outside Den's gate."
      }
    ],
